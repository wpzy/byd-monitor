# 安装器会把本模板放到 /etc/byd-monitor/byd-monitor.env（权限 0640，不入库）
# 修改后执行：sudo systemctl restart byd-monitor

# 云主机公网 IP 经 NAT 映射，必须监听所有网卡；127.0.0.1 仅用于本机健康检查
HOST=0.0.0.0
PORT=8767

# 服务器登记信息，供运维与验收脚本使用（不作为绑定地址）
# PUBLIC_SERVER_IP=
# PRIVATE_SERVER_IP=

# 每交易日收盘后自动抓取（北京时间 UTC+8）
UPDATE_HOUR=15
UPDATE_MINUTE=30
SCHED_CHECK_SECONDS=60
SKIP_WEEKENDS=1
RUN_ON_START=1

# 多标的看板（/portfolio）：每交易日 15:30 随主刷新一起更新 17 个标的（含比亚迪）
PORTFOLIO_AUTO=1
PORTFOLIO_WORKERS=6

# 公网部署强烈建议设置刷新令牌，避免手动刷新接口被任意调用
# REFRESH_TOKEN=replace-with-a-long-random-string

PYTHONUNBUFFERED=1
TZ=Asia/Shanghai
