# 复制为 .env 后由 deploy_web_server.sh 自动加载；systemd 部署请用
# deploy/ubuntu24/byd-monitor.env.example 放到 /etc/byd-monitor/byd-monitor.env
HOST=0.0.0.0
PORT=8767

# 每交易日收盘后的自动刷新时间（北京时间 UTC+8）
UPDATE_HOUR=15
UPDATE_MINUTE=30
SCHED_CHECK_SECONDS=60
SKIP_WEEKENDS=1
RUN_ON_START=1

# 多标的看板（/portfolio）：每交易日随主刷新一起更新 16 个 ETF / 个股
# 设为 0 可关闭自动更新；WORKERS 控制并发抓取线程数
PORTFOLIO_AUTO=1
PORTFOLIO_WORKERS=6

# 可选：手动刷新接口的令牌，留空表示不鉴权（仅限内网/本机使用）
# REFRESH_TOKEN=replace-with-a-long-random-string

# 可选：覆盖 config.json 中的标的与持仓成本
# SYMBOL=002594
# COST_PRICE=

PYTHONUNBUFFERED=1
TZ=Asia/Shanghai
