# Windows 开发 / Linux 服务器部署：脚本与配置强制 LF，
# 避免 clone 到 Linux 后出现 /bin/bash^M: bad interpreter 或 $'\r': command not found
* text=auto

*.sh          text eol=lf
*.service     text eol=lf
*.env*        text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.json        text eol=lf
*.js          text eol=lf
*.html        text eol=lf
*.md          text eol=lf
*.txt         text eol=lf

# 压缩后的第三方图表库按字节保存，不做任何换行转换
assets/*.js   -text
